// =====================================================================
// REGRAS DE SEGURANÇA DO FIRESTORE — Central Financeira
// Este arquivo NÃO roda sozinho: copie tudo e cole no console do Firebase
// (Firestore Database › Regras › Publicar). São estas regras, e não o
// código do site, que protegem os dados: o site é público e qualquer um
// pode abrir o JavaScript, mas o servidor do Firebase só aceita o que
// passar aqui.
//
// Hoje só existe a coleção usuarios/{uid}, com:
//   nome, login (o e-mail interno da conta, ex.: fulano.de.tal@conferencia.local),
//   papel ("usuario" | "adm"), status ("aguardando" | "liberado" |
//   "bloqueado"), criadoEm, ultimoAcesso e, só depois de um "Resetar
//   acesso" do adm, resetPedido (true = a conta vai ser excluída no console
//   e recriada com o mesmo nome), e permissoes: { telas: [...], empresas: [...] }
//   (só o adm grava; sem o campo = nenhuma tela e nenhuma empresa; o adm vê tudo).
// O "nome" é só o que a pessoa digitou; o "login" é conferido aqui contra o
// e-mail da conta (request.auth.token.email), então é ele que diz quem é quem.
// historico/{id}: um registro por conferência feita ou .RET baixado, com
//   uid, login, nome, quando, tela, banco, empresa (empresa2) e abas
//   ({ idDaAba: quantidade inteira }). NUNCA fornecedor, código ou valor:
//   as regras abaixo recusam qualquer outro campo e qualquer aba que não
//   seja um número inteiro.
// Coleção nova (controle do .RET...) só funciona depois de
// ganhar regra própria aqui: o resto fica fechado (última regra).
// =====================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções de apoio ----------

    // Está logado (o Firebase Authentication confirmou quem é).
    function logado() {
      return request.auth != null;
    }

    // É o dono do cadastro {uid}: o login é o mesmo do documento.
    function dono(uid) {
      return logado() && request.auth.uid == uid;
    }

    // É administrador: o PRÓPRIO cadastro (lido no servidor, não o que o
    // navegador diz) tem papel "adm" E status "liberado". Um adm bloqueado
    // perde os poderes na hora.
    function ehAdm() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'adm'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.status == 'liberado';
    }

    // O nome é texto de 3 a 60 caracteres (o mesmo limite da tela de entrada).
    function nomeValido(nome) {
      return nome is string && nome.size() >= 3 && nome.size() <= 60;
    }

    // Permissões válidas: um mapa só com "telas" e "empresas", cada um uma lista
    // com ids conhecidos (os mesmos do js/login/permissoes.js e do js/empresas.js).
    function permissoesValidas(p) {
      return p is map
        && p.keys().hasOnly(['telas', 'empresas'])
        && p.keys().hasAll(['telas', 'empresas'])
        && p.telas is list && p.telas.size() <= 10
        && p.telas.hasOnly(['conferencia-dda', 'codigo-barras', 'conferencia-boletos', 'dda-ret'])
        && p.empresas is list && p.empresas.size() <= 10
        && p.empresas.hasOnly(['crv-matriz', 'crv-filial', 'rubi-matriz', 'rubi-filial']);
    }

    // Os 6 campos do cadastro: nenhum a mais.
    function soCamposDoCadastro() {
      return request.resource.data.keys().hasOnly(['nome', 'login', 'papel', 'status', 'criadoEm', 'ultimoAcesso']);
    }

    // O login gravado é o e-mail da conta que está fazendo o pedido
    // (o Firebase Authentication diz qual é; o navegador não consegue falsificar).
    function loginDaConta() {
      return request.resource.data.login is string
        && request.resource.data.login == request.auth.token.email;
    }

    // O login não mudou (vale também para cadastro antigo sem login: continua sem).
    function loginIntocado() {
      return request.resource.data.get('login', null) == resource.data.get('login', null);
    }

    // ---------- usuarios/{uid} ----------
    match /usuarios/{uid} {

      // LER: cada um lê só o próprio cadastro; o adm lê todos.
      allow read: if dono(uid) || ehAdm();

      // CRIAR: só o próprio cadastro, logo depois de criar a conta, e só do
      // jeito "conta nova": exatamente os 6 campos, login == e-mail da conta,
      // papel "usuario", status "aguardando" e as duas datas com a hora do
      // servidor (request.time). Assim ninguém nasce adm nem liberado, não
      // inventa data e não cria cadastro com o login de outra pessoa.
      allow create: if dono(uid)
        && soCamposDoCadastro()
        && request.resource.data.keys().hasAll(['nome', 'login', 'papel', 'status', 'criadoEm', 'ultimoAcesso'])
        && nomeValido(request.resource.data.nome)
        && loginDaConta()
        && request.resource.data.papel == 'usuario'
        && request.resource.data.status == 'aguardando'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.ultimoAcesso == request.time;

      // ATUALIZAR (a própria pessoa): só o ultimoAcesso, com a hora do servidor.
      // Qualquer outro campo mudado (papel, status, nome, login, criadoEm) faz
      // o Firebase recusar: ninguém se promove nem se libera sozinho.
      // Única exceção: cadastro antigo, criado antes do campo "login", pode
      // ganhar o login UMA vez, e só se for o e-mail da própria conta.
      allow update: if dono(uid)
        && request.resource.data.ultimoAcesso == request.time
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcesso'])
          || (!('login' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcesso', 'login'])
              && loginDaConta())
        );

      // ATUALIZAR (adm — tela Administração › Usuários): o adm muda SÓ nome,
      // status, papel, resetPedido e permissoes (liberar, bloquear, editar o
      // nome, tornar adm, resetar acesso, marcar telas e empresas). Os outros campos (login, criadoEm, ultimoAcesso)
      // ficam exatamente como estão: o adm não troca a identidade de ninguém
      // nem mexe na data de acesso. Nome válido, papel e status só com os
      // valores conhecidos. resetPedido é true/false, e true só junto com
      // "bloqueado" (quem está com reset pedido não entra).
      allow update: if ehAdm()
        && request.resource.data.keys().hasOnly(['nome', 'login', 'papel', 'status', 'criadoEm', 'ultimoAcesso', 'resetPedido', 'permissoes'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'status', 'papel', 'resetPedido', 'permissoes'])
        && (!('permissoes' in request.resource.data) || permissoesValidas(request.resource.data.permissoes))
        && nomeValido(request.resource.data.nome)
        && loginIntocado()
        && request.resource.data.papel in ['usuario', 'adm']
        && request.resource.data.status in ['aguardando', 'liberado', 'bloqueado']
        && (!('resetPedido' in request.resource.data) || request.resource.data.resetPedido is bool)
        && (request.resource.data.get('resetPedido', false) != true || request.resource.data.status == 'bloqueado');

      // APAGAR: só o adm, e só o cadastro ANTIGO de um reset (resetPedido true
      // e bloqueado), ao liberar o cadastro novo da mesma pessoa. Para tirar
      // alguém do site, o adm bloqueia; apagar outro cadastro só pelo console.
      allow delete: if ehAdm()
        && resource.data.get('resetPedido', false) == true
        && resource.data.status == 'bloqueado';
    }

    // ---------- historico/{id} ----------

    // Cadastro de quem está pedindo (lido no servidor).
    function meuCadastro() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // O cadastro c pode usar a tela / a empresa? Adm: tudo. Os outros: só o que o adm marcou.
    function podeTela(c, tela) {
      return c.papel == 'adm' || tela in c.get('permissoes', {'telas': [], 'empresas': []}).get('telas', []);
    }
    function podeEmpresa(c, empresa) {
      return c.papel == 'adm' || empresa in c.get('permissoes', {'telas': [], 'empresas': []}).get('empresas', []);
    }

    // Uma aba do registro: ausente, ou um inteiro de 0 a 100000 (nunca texto nem valor em R$).
    function qtdOk(a, id) {
      return !(id in a) || (a[id] is int && a[id] >= 0 && a[id] <= 100000);
    }

    // As abas conhecidas (as mesmas do ABAS_HISTORICO do js/login/historico.js), cada uma só número inteiro.
    function abasValidas(a) {
      return a is map
        && a.keys().hasOnly(['ok', 'data', 'nome', 'banco', 'sis', 'valor', 'dup', 'mesmo', 'duplo', 'linha',
                             'verif', 'sem', 'dda', 'noArquivo', 'fora', 'atencao'])
        && qtdOk(a, 'ok') && qtdOk(a, 'data') && qtdOk(a, 'nome') && qtdOk(a, 'banco') && qtdOk(a, 'sis')
        && qtdOk(a, 'valor') && qtdOk(a, 'dup') && qtdOk(a, 'mesmo') && qtdOk(a, 'duplo') && qtdOk(a, 'linha')
        && qtdOk(a, 'verif') && qtdOk(a, 'sem') && qtdOk(a, 'dda') && qtdOk(a, 'noArquivo') && qtdOk(a, 'fora')
        && qtdOk(a, 'atencao');
    }

    match /historico/{registro} {

      // LER: só o adm (tela Administração › Histórico).
      allow read: if ehAdm();

      // CRIAR: quem está liberado, só em nome próprio (uid, login e nome do próprio
      // cadastro), com a hora do servidor, só os campos da lista, tela e empresa(s)
      // que ele tem permissão de usar, e as abas só com quantidades inteiras.
      allow create: if logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && meuCadastro().status == 'liberado'
        && request.resource.data.keys().hasOnly(['uid', 'login', 'nome', 'quando', 'tela', 'banco', 'empresa', 'empresa2', 'abas'])
        && request.resource.data.keys().hasAll(['uid', 'login', 'nome', 'quando', 'tela', 'banco', 'empresa', 'abas'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.login == request.auth.token.email
        && request.resource.data.nome == meuCadastro().nome
        && request.resource.data.quando == request.time
        && request.resource.data.tela in ['conferencia-dda', 'codigo-barras', 'conferencia-boletos', 'dda-ret']
        && podeTela(meuCadastro(), request.resource.data.tela)
        && request.resource.data.banco in ['santander', 'itau', 'bradesco', '']
        && request.resource.data.empresa in ['crv-matriz', 'crv-filial', 'rubi-matriz', 'rubi-filial']
        && podeEmpresa(meuCadastro(), request.resource.data.empresa)
        && (!('empresa2' in request.resource.data)
            || (request.resource.data.empresa2 in ['crv-matriz', 'crv-filial', 'rubi-matriz', 'rubi-filial']
                && podeEmpresa(meuCadastro(), request.resource.data.empresa2)))
        && abasValidas(request.resource.data.abas);

      // EDITAR e APAGAR: ninguém, nem o adm (só pelo console do Firebase).
      allow update, delete: if false;
    }

    // ---------- todo o resto ----------
    // Qualquer outra coleção ou documento: fechado para leitura e escrita.
    // (As regras do Firebase somam permissões: o que não foi liberado acima
    // continua proibido.)
    match /{qualquerDocumento=**} {
      allow read, write: if false;
    }
  }
}
